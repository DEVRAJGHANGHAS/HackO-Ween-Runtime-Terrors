# FoodResQ AI Backend Environment Configuration

PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/foodresq_ai

# JWT Authentication Secret
JWT_SECRET=foodresq_jwt_super_secure_development_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5001,http://localhost:5001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Optional External AI API Key for Enhanced Coordinator Explanations
GEMINI_API_KEY=your_gemini_api_key_here
